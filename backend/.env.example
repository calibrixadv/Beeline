# Beeline VoyageRail Backend Environment Configuration Template
# Copy this file to .env and adjust variables as needed. NEVER commit real secrets to Git.

# Application Environment (development | staging | production)
ENVIRONMENT="development"
PROJECT_NAME="Beeline VoyageRail API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & JWT Tokens
# Generate a cryptographically strong 32+ character key for production (e.g. openssl rand -hex 32)
SECRET_KEY="your-super-secret-jwt-key-min-32-chars-change-in-prod"
JWT_SECRET_KEY="your-super-secret-jwt-key-min-32-chars-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_TEMP_TOKEN_EXPIRE_MINUTES=5
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
MFA_ISSUER_NAME="Beeline VoyageRail"

# Auth Rate Limiting
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=30

# Database Configuration
# Local SQLite development default:
DATABASE_URL="sqlite+aiosqlite:///./beeline.db"
# Production PostgreSQL (Render / Docker Compose):
# DATABASE_URL="postgresql+asyncpg://beeline:beeline_secret@localhost:5432/beeline_db"

# Redis & Online Feature Store Configuration
REDIS_URL="redis://localhost:6379/0"
REDIS_FEATURE_PREFIX="feature:"
REDIS_FEATURE_TTL_SECONDS=86400
FEATURE_SYNC_INTERVAL_SECONDS=60
ENABLE_ML_INFERENCE=true
ML_MODEL_PATH="app/ml_models/risk_model.onnx"
ML_METADATA_PATH="app/ml_models/risk_model_metadata.json"

# Email & SMTP Engine Configuration
EMAIL_MODE="dev_sink" # Use "smtp" for live production email delivery, "dev_sink" for local/test
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@beeline.voyagerail.com"
EMAIL_RATE_LIMIT_PER_SEC=500
FRONTEND_URL="http://localhost:3000"

# Trip Departure & Delay Notifications
TRIP_REMINDER_WINDOW_MINUTES=60
TRIP_NOTIFICATION_POLL_SECONDS=60
ENABLE_TRIP_NOTIFICATION_WORKER=true

# CORS Allowed Origins
# Comma-separated list or JSON array of allowed origins for cross-origin credentials (cookies)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://localhost:19006,https://beeline.vercel.app"
