# Beeline VoyageRail Backend Environment Configuration

PROJECT_NAME="Beeline VoyageRail API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & JWT
SECRET_KEY="beeline-super-secret-key-development-vault-change-in-prod-32chars"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
MFA_ISSUER_NAME="Beeline VoyageRail"

# Database Configuration
# Default: Local zero-setup SQLite database
DATABASE_URL="sqlite+aiosqlite:///./beeline.db"

# Optional: PostgreSQL Database (e.g., via docker-compose up -d)
# DATABASE_URL="postgresql+asyncpg://beeline:beeline_secret@localhost:5432/beeline_db"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000","*"]
