# Beeline VoyageRail Frontend Environment Configuration Template
# Copy this file to .env.local for local development. NEVER commit real secrets to Git.

# Environment Mode (development | test | production)
ENVIRONMENT="development"

# Public API Gateway URL (Next.js client-side & SSR requests)
# Local Docker / Uvicorn backend:
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
# Production Render backend example:
# NEXT_PUBLIC_API_URL="https://beeline-api.onrender.com/api/v1"

# Internal Server-Side Backend URL (used by Next.js rewrites in SSR / Container environments)
BACKEND_INTERNAL_URL="http://localhost:8000"
